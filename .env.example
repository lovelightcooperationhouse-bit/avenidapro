# ==============================================================================
# AVENIDA MANAGEMENT — ENV VARIABLES TEMPLATE
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret Key (NEVER expose to the client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Paiement en ligne : PayDunya (Mixx by Yas, Moov Money, carte bancaire) — IPN : /api/paiements/paydunya
PAYDUNYA_MASTER_KEY=...
PAYDUNYA_PRIVATE_KEY=live_private_...
PAYDUNYA_TOKEN=...
# PAYDUNYA_SANDBOX=oui   (uniquement pour les essais avec les clés test_)

# Référencement : codes de validation Google Search Console et Bing Webmaster Tools
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Currency & Locale Defaults
DEFAULT_CURRENCY=XOF
DEFAULT_LOCALE=fr-TG
DEFAULT_SITE_NAME=DEKON
